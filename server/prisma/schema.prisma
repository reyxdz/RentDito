  reviewedBy  String?   @map("reviewed_by") @db.Uuid
  reviewedAt  DateTime? @map("reviewed_at") @db.Timestamptz
  reviewNotes String?   @map("review_notes")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user     Profile  @relation("LandlordApplicationApplicant", fields: [userId], references: [id], onDelete: Restrict)
  reviewer Profile? @relation("LandlordApplicationReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([reviewedBy])
  @@map("landlord_applications")
}

model AuditLog {
  id           String  @id @default(uuid()) @db.Uuid
  userId       String  @map("user_id") @db.Uuid
  action       String
  resourceType String  @map("resource_type")
  resourceId   String? @map("resource_id")
  details      Json?
  ip           String?

  timestamp DateTime @default(now()) @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user Profile @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([resourceType, resourceId])
  @@index([timestamp(sort: Desc)])
  @@map("audit_logs")
}
