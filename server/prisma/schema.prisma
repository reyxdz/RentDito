model TransferRequest {
  id                String         @id @default(uuid()) @db.Uuid
  tenancyId         String         @map("tenancy_id") @db.Uuid
  propertyId        String         @map("property_id") @db.Uuid
  fromUnitId        String         @map("from_unit_id") @db.Uuid
  toUnitId          String         @map("to_unit_id") @db.Uuid
  reason            String
  status            TransferStatus @default(pending)
  initiatedByUserId String         @map("initiated_by_user_id") @db.Uuid

  reviewedBy  String?   @map("reviewed_by") @db.Uuid
  reviewNotes String?   @map("review_notes")
  reviewedAt  DateTime? @map("reviewed_at") @db.Timestamptz
  completedAt DateTime? @map("completed_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenancy     Tenancy  @relation(fields: [tenancyId], references: [id], onDelete: Cascade)
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  fromUnit    Unit     @relation("TransferFromUnit", fields: [fromUnitId], references: [id], onDelete: Cascade)
  toUnit      Unit     @relation("TransferToUnit", fields: [toUnitId], references: [id], onDelete: Cascade)
  initiatedBy Profile  @relation("TransferInitiator", fields: [initiatedByUserId], references: [id], onDelete: Restrict)
  reviewer    Profile? @relation("TransferReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([tenancyId, status])
  @@index([propertyId, status])
  @@index([initiatedByUserId, createdAt(sort: Desc)])
  @@index([fromUnitId, toUnitId])
  @@index([createdAt(sort: Desc)])
  @@index([toUnitId])
  @@index([reviewedBy])
  @@map("transfer_requests")
}

model VisitRequest {
  id            String       @id @default(uuid()) @db.Uuid
  userId        String       @map("user_id") @db.Uuid
  propertyId    String       @map("property_id") @db.Uuid
  unitId        String?      @map("unit_id") @db.Uuid
  requestedDate DateTime     @map("requested_date") @db.Timestamptz
  requestedTime String       @map("requested_time")
  scheduledDate DateTime?    @map("scheduled_date") @db.Timestamptz
  scheduledTime String?      @map("scheduled_time")
  purpose       VisitPurpose @default(viewing)
  status        VisitStatus  @default(pending)

  assignedStaffId String? @map("assigned_staff_id") @db.Uuid
  notes           String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user          Profile  @relation("VisitRequester", fields: [userId], references: [id], onDelete: Restrict)
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit          Unit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)
  assignedStaff Profile? @relation("VisitStaff", fields: [assignedStaffId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([propertyId, status])
  @@index([assignedStaffId, status])
  @@index([scheduledDate, scheduledTime])
  @@index([unitId])
  @@map("visit_requests")
}

